# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key (GHP Key injected by AI Studio)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# ==============================================================================
# SERVER SMTP CONFIGURATION (Required for real 6-digit OTP email delivery)
# All sensitive credentials stay server-side in .env and are NEVER exposed to the frontend.
# Example for Gmail STARTTLS (Port 587):
#   - Enable 2-Step Verification on your Google Account
#   - Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="studiomaldecenasoeiro@gmail.com"
SMTP_PASSWORD="your_16_char_app_password"
SMTP_FROM="GeoApex <studiomaldecenasoeiro@gmail.com>"
SMTP_SECURE="false"

# Optional secret used for HMAC-SHA256 hashing of 6-digit OTP codes in PostgreSQL
OTP_HMAC_SECRET="replace_with_a_random_32_byte_hex_secret"
